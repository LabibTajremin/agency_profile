<?xml version="1.0"?>
<ruleset name="Edulume">
    <description>PSR-12 for framework-agnostic code, WordPress Coding Standards for WordPress-facing code.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>plugins/edulume-core/src</file>
    <file>plugins/edulume-core/tests</file>
    <file>bin</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Test method names are sentences by policy: it_generates_a_palette_from_a_custom_hex(). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- CLI entry points legitimately declare helpers and then run. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>bin/*</exclude-pattern>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="140"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <rule ref="Generic.Metrics.CyclomaticComplexity">
        <properties>
            <property name="complexity" value="12"/>
            <property name="absoluteComplexity" value="20"/>
        </properties>
    </rule>
</ruleset>
