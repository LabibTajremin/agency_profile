<?xml version="1.0"?>
<ruleset name="Edulume security">
    <description>
        The WordPress security ruleset, run as its own CI job.

        Kept separate from phpcs.xml.dist deliberately: WPCS cannot be installed in every
        environment this repository is developed in, and folding it into the main lint would
        make the everyday `composer lint` unrunnable there. As its own job with its own
        dependency install, it either runs and passes or it fails loudly — never silently
        skipped inside a green lint.
    </description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <file>plugins/edulume-core/src</file>
    <file>plugins/edulume-core/edulume-core.php</file>
    <file>plugins/edulume-core/uninstall.php</file>
    <file>themes/edulume-theme</file>
    <file>themes/edulume-child</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>

    <rule ref="WordPress.Security">
        <properties>
            <!--
                CSS printed into a <style> element cannot be escaped with esc_html() — that
                mangles the `>` in every child selector. edulume_escape_css() removes what
                actually matters in that context: anything that could close the element.
            -->
            <property name="customEscapingFunctions" type="array">
                <element value="edulume_escape_css"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <rule ref="WordPress.WP.EnqueuedResourceParameters"/>

    <config name="minimum_wp_version" value="6.4"/>
    <config name="text_domain" value="edulume"/>
</ruleset>
